{
  "name": "hold-my-brief",
  "private": true,
  "version": "0.1.0",
  "description": "A compact, pinnable desktop reader for PDF, EPUB, Markdown, text and images",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/secure-foliate.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "node tests/browser/native-smoke.mjs && node tests/browser/raw-bytes-smoke.mjs",
    "test:layout": "node tests/browser/text-layout.mjs",
    "postinstall": "node scripts/secure-foliate.mjs",
    "desktop": "tauri dev",
    "package": "tauri build",
    "package:macos": "bash src-tauri/build-macos.sh",
    "perf": "node tests/perf/run.mjs",
    "perf:json": "node tests/perf/run.mjs --json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@zip.js/zip.js": "2.24.0",
    "foliate-js": "1.0.1",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/markdown-it": "14.2.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
